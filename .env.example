# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-org-name

# ── Trello ────────────────────────────────────────────────────────────────────
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
# Comma-separated board IDs to scan (leave empty to scan all boards you have access to)
TRELLO_BOARD_IDS=boardId1,boardId2
# Name(s) of "done" list(s) — comma-separated, case-insensitive substring match
TRELLO_DONE_LIST_NAMES=Done,Completed,Finished

# ── Google (OAuth2 — place credentials.json in the project root) ───────────────
# Folder ID in Google Drive where reports will be uploaded
# (Right-click the folder in Drive → "Get link" → extract the ID from the URL)
GOOGLE_DRIVE_FOLDER_ID=1ABCdef_xxxxxxxxxxxxxxxxxxxxxx

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_SENDER=you@yourcompany.com
EMAIL_RECIPIENT=boss@yourcompany.com
EMAIL_SUBJECT_TEMPLATE=Weekly Team Report – {week_range}

# ── Gemini AI (optional — enables per-developer AI summaries in Portuguese) ────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Optional: map GitHub usernames → real names ───────────────────────────────
# JSON object, e.g. {"githubuser": "Alice Smith", "dev42": "Bob Jones"}
DEVELOPER_NAME_MAP={}

# ── Optional: ignore these GitHub logins (bots, CI accounts, etc.) ────────────
GITHUB_IGNORE_LOGINS=dependabot[bot],github-actions[bot]
